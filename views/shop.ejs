<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shop Designs — Ink & Dye Tees</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body
    class="bg-[#FAF9F5] text-black font-sans min-h-screen flex flex-col justify-between"
  >
    <!-- Header injected here -->
    <!-- [Include Header Template Code Here] -->
    <!-- Dynamically injects the reusable header layout component here -->
    <%- include('partials/header') %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-1 w-full">
      <div class="mb-8">
        <h1 class="text-4xl font-black tracking-tight mb-2">
          Shop All Designs
        </h1>
        <p class="text-neutral-600">
          Browse our curated handmade drops and ready-to-ship artwork tees.
        </p>
      </div>
      <!-- Product Grid -->
      <div
        id="shop-product-grid"
        class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8"
      >
        <!-- Dynamically populated -->
      </div>
    </main>

    <!-- Slide-over Cart Drawer -->
    <div
      id="cart-drawer"
      class="fixed inset-y-0 right-0 z-50 w-full max-w-md bg-[#FAF9F5] border-l border-black/20 shadow-2xl transform translate-x-full transition-transform duration-300 flex flex-col"
    >
      <div
        class="p-6 border-b border-black/10 flex items-center justify-between"
      >
        <h3 class="font-black text-lg">Your Cart</h3>
        <button onclick="toggleCart()" class="p-2 font-bold hover:text-red-500">
          ✕
        </button>
      </div>
      <div
        id="cart-items-container"
        class="flex-1 overflow-y-auto p-6 space-y-4 custom-scrollbar"
      ></div>
      <div class="p-6 border-t border-black/10 bg-neutral-100">
        <div class="flex justify-between font-bold mb-4">
          <span>Subtotal</span>
          <span id="cart-total">$0.00</span>
        </div>
        <button
          onclick="alert('Checkout integration ready!')"
          class="w-full py-3.5 bg-black text-[#D4FF00] font-black rounded-xl hover:bg-neutral-800 transition"
        >
          Checkout Now
        </button>
      </div>
    </div>

    <script src="/js/app.js"></script>
    <script>
      async function loadShopProducts() {
        try {
          const res = await fetch("/api/products");
          const products = await res.json();
          const grid = document.getElementById("shop-product-grid");
          grid.innerHTML = products
            .map(
              (p) => `
                    <div class="group border border-black/10 rounded-2xl p-4 bg-white hover:border-black transition flex flex-col justify-between">
                        <div>
                            <div class="relative overflow-hidden rounded-xl aspect-[4/5] mb-4 bg-neutral-100">
                                <img src="${p.image}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" alt="${p.name}">
                                <span class="absolute top-3 left-3 bg-[#D4FF00] text-black text-[10px] font-black px-2.5 py-1 rounded-full border border-black">${p.badge}</span>
                            </div>
                            <h3 class="font-bold text-base mb-1">${p.name}</h3>
                            <p class="text-neutral-500 text-sm mb-4">$${p.price.toFixed(2)}</p>
                        </div>
                        <button onclick="addToCart(${p.id}, '${p.name}', ${p.price}, '${p.image}')" class="w-full py-2.5 bg-black text-[#FAF9F5] font-bold text-sm rounded-xl hover:bg-[#D4FF00] hover:text-black border border-black transition">Add to Cart</button>
                    </div>
                `,
            )
            .join("");
        } catch (err) {
          console.error("Failed to load products", err);
        }
      }
      loadShopProducts();
    </script>
  </body>
</html>

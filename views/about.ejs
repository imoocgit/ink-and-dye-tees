<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About — Ink & Dye Tees</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css" />
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              offwhite: "#F8F7F4",
              charcoal: "#1E1E1E",
              washedblack: "#121212",
              lavender: "#D8C7FF",
              lime: "#CCFF00",
              lavenderDark: "#bfa4ff",
            },
            fontFamily: {
              sans: ['"Plus Jakarta Sans"', "sans-serif"],
              display: ['"Space Grotesk"', "sans-serif"],
            },
            boxShadow: {
              genz: "4px 4px 0px #1E1E1E",
              "genz-sm": "2px 2px 0px #1E1E1E",
              "genz-lime": "4px 4px 0px #CCFF00",
              "genz-lav": "4px 4px 0px #D8C7FF",
            },
          },
        },
      };
    </script>
  </head>
  <!-- <body    class="bg-[#FAF9F5] text-black font-sans min-h-screen flex flex-col justify-between"  > -->
  <body
    class="font-sans antialiased selection:bg-lime selection:text-charcoal min-h-screen flex flex-col justify-between"
  >
    <!-- Header injected here -->
    <!-- [Include Header Template Code Here] -->
    <!-- Dynamically injects the reusable header layout component here -->
    <%- include('partials/header') %>

    <!-- TAB 4: ABOUT -->
    <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-1 w-full">
      <div class="max-w-4xl mx-auto space-y-12">
        <div class="text-center space-y-4">
          <span
            class="bg-lavender text-charcoal font-display font-bold text-xs uppercase px-3 py-1 rounded-full border-2 border-charcoal shadow-genz-sm inline-block"
            >The Artist Story</span
          >
          <h1 class="font-display font-extrabold text-4xl sm:text-6xl">
            Handmade, Never Mass-Produced.
          </h1>
          <p class="text-charcoal/80 text-lg max-w-2xl mx-auto">
            Ink & Dye Tees was born out of a passion for subversive streetwear,
            anime culture, and tactile textile art.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div
            class="bg-charcoal text-offwhite p-8 rounded-3xl border-4 border-charcoal shadow-genz space-y-4"
          >
            <div
              class="w-12 h-12 bg-lime text-charcoal font-black rounded-xl border-2 border-charcoal flex items-center justify-center text-xl"
            >
              <i class="fa-solid fa-hands-bubbles"></i>
            </div>
            <h3 class="font-display font-bold text-2xl text-lime">
              The Handmade Process
            </h3>
            <p class="text-offwhite/80 text-sm leading-relaxed">
              Every single t-shirt is hand-tied, hand-dyed using eco-conscious
              vibrant fiber-reactive dyes, and hand-painted or custom
              heat-pressed with archival inks in small experimental batches in
              our studio. No two shirts will ever look identical.
            </p>
          </div>
          <div
            class="bg-lavender p-8 rounded-3xl border-4 border-charcoal shadow-genz space-y-4"
          >
            <div
              class="w-12 h-12 bg-charcoal text-lime font-black rounded-xl border-2 border-charcoal flex items-center justify-center text-xl"
            >
              <i class="fa-solid fa-shield-halved"></i>
            </div>
            <h3 class="font-display font-bold text-2xl text-charcoal">
              Copyright & Ethics
            </h3>
            <p class="text-charcoal/80 text-sm leading-relaxed">
              We respect intellectual property. All featured anime and
              streetwear artwork is either original creations by our in-house
              illustrators, properly licensed, or custom-printed directly from
              customer-provided images and fan artwork permissions.
            </p>
          </div>
        </div>

        <!-- Gallery of Process -->
        <div class="space-y-6">
          <h3 class="font-display font-extrabold text-2xl text-center">
            Studio & Process Glimpse
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div
              class="aspect-square bg-offwhite border-2 border-charcoal rounded-2xl overflow-hidden shadow-genz-sm"
            >
              <img
                src="https://placehold.co/500x500/1E1E1E/CCFF00?text=Tie+Dye+Vat"
                alt="Process 1"
                class="w-full h-full object-cover hover:scale-105 transition-transform"
              />
            </div>
            <div
              class="aspect-square bg-offwhite border-2 border-charcoal rounded-2xl overflow-hidden shadow-genz-sm"
            >
              <img
                src="https://placehold.co/500x500/D8C7FF/1E1E1E?text=Hand+Painting"
                alt="Process 2"
                class="w-full h-full object-cover hover:scale-105 transition-transform"
              />
            </div>
            <div
              class="aspect-square bg-offwhite border-2 border-charcoal rounded-2xl overflow-hidden shadow-genz-sm"
            >
              <img
                src="https://placehold.co/500x500/CCFF00/1E1E1E?text=Final+Press"
                alt="Process 3"
                class="w-full h-full object-cover hover:scale-105 transition-transform"
              />
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Slide-over Cart Drawer -->
    <div
      id="cart-drawer"
      class="fixed inset-y-0 right-0 z-50 w-full max-w-md bg-[#FAF9F5] border-l border-black/20 shadow-2xl transform translate-x-full transition-transform duration-300 flex flex-col"
    >
      <div
        class="p-6 border-b border-black/10 flex items-center justify-between"
      >
        <h3 class="font-black text-lg">Your Cart</h3>
        <button onclick="toggleCart()" class="p-2 font-bold hover:text-red-500">
          ✕
        </button>
      </div>
      <div
        id="cart-items-container"
        class="flex-1 overflow-y-auto p-6 space-y-4 custom-scrollbar"
      ></div>
      <div class="p-6 border-t border-black/10 bg-neutral-100">
        <div class="flex justify-between font-bold mb-4">
          <span>Subtotal</span>
          <span id="cart-total">$0.00</span>
        </div>
        <button
          onclick="alert('Checkout integration ready!')"
          class="w-full py-3.5 bg-black text-[#D4FF00] font-black rounded-xl hover:bg-neutral-800 transition"
        >
          Checkout Now
        </button>
      </div>
    </div>

    <!-- Footer -->
    <footer class="bg-charcoal text-offwhite border-t-4 border-charcoal mt-20">
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 md:grid-cols-4 gap-8"
      >
        <div class="space-y-4">
          <a
            href="/"
            class="text-1xl font-black tracking-tighter flex items-center gap-2"
          >
            <span
              class="w-4 h-4 rounded-full bg-[#D4FF00] border-2 border-black"
            ></span>
            INK & DYE <span class="text-neutral-500 font-light">TEES</span>
          </a>
          <p class="text-offwhite/70 text-xs">
            Handmade, hand-dyed custom streetwear crafted for Gen Z art, anime,
            and rebellious fashion fans.
          </p>
        </div>
        <div>
          <h4 class="font-display font-bold text-lime mb-3">
            Quick Navigation
          </h4>
          <ul class="space-y-2 text-xs font-semibold">
            <li>
              <a
                href="/"
                onclick="switchTab('home')"
                class="hover:text-lime transition-colors"
                >Home</a
              >
            </li>
            <li>
              <a
                href="/shop"
                onclick="switchTab('shop')"
                class="hover:text-lime transition-colors"
                >Shop Catalog</a
              >
            </li>
            <li>
              <a
                href="/custom"
                onclick="switchTab('custom')"
                class="hover:text-lime transition-colors"
                >Custom Tee Builder</a
              >
            </li>
            <li>
              <a
                href="/about"
                onclick="switchTab('about')"
                class="hover:text-lime transition-colors"
                >About Artist & Process</a
              >
            </li>
          </ul>
        </div>
        <div>
          <h4 class="font-display font-bold text-lime mb-3">Customer Care</h4>
          <ul class="space-y-2 text-xs font-semibold">
            <li>
              <a
                href="/faq"
                onclick="switchTab('faq')"
                class="hover:text-lime transition-colors"
                >Pricing & Turnaround</a
              >
            </li>
            <li>
              <a
                href="/faq"
                onclick="switchTab('faq')"
                class="hover:text-lime transition-colors"
                >Shipping & Returns</a
              >
            </li>
            <li>
              <a
                href="#faq"
                onclick="switchTab('faq')"
                class="hover:text-lime transition-colors"
                >Wash & Care Instructions</a
              >
            </li>
            <li>
              <a
                href="#faq"
                onclick="switchTab('faq')"
                class="hover:text-lime transition-colors"
                >Copyright & Licensing</a
              >
            </li>
          </ul>
        </div>
        <div>
          <h4 class="font-display font-bold text-lime mb-3">Connect With Us</h4>
          <div class="flex gap-3 mb-4">
            <a
              href="#"
              class="w-9 h-9 bg-offwhite/10 text-offwhite hover:bg-lime hover:text-charcoal rounded-xl border border-offwhite/20 flex items-center justify-center transition-colors"
              ><i class="fa-brands fa-instagram"></i
            ></a>
            <a
              href="#"
              class="w-9 h-9 bg-offwhite/10 text-offwhite hover:bg-lime hover:text-charcoal rounded-xl border border-offwhite/20 flex items-center justify-center transition-colors"
              ><i class="fa-brands fa-tiktok"></i
            ></a>
            <a
              href="#"
              class="w-9 h-9 bg-offwhite/10 text-offwhite hover:bg-lime hover:text-charcoal rounded-xl border border-offwhite/20 flex items-center justify-center transition-colors"
              ><i class="fa-brands fa-discord"></i
            ></a>
          </div>
          <p class="text-xs text-offwhite/50">
            &copy; 2026 Ink & Dye Tees. All rights reserved. Original artwork &
            custom designs protected.
          </p>
        </div>
      </div>
    </footer>

    <script src="/js/app.js"></script>
  </body>
</html>

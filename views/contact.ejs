<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact — Ink & Dye Tees</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css" />
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              offwhite: "#F8F7F4",
              charcoal: "#1E1E1E",
              washedblack: "#121212",
              lavender: "#D8C7FF",
              lime: "#CCFF00",
              lavenderDark: "#bfa4ff",
            },
            fontFamily: {
              sans: ['"Plus Jakarta Sans"', "sans-serif"],
              display: ['"Space Grotesk"', "sans-serif"],
            },
            boxShadow: {
              genz: "4px 4px 0px #1E1E1E",
              "genz-sm": "2px 2px 0px #1E1E1E",
              "genz-lime": "4px 4px 0px #CCFF00",
              "genz-lav": "4px 4px 0px #D8C7FF",
            },
          },
        },
      };
    </script>
  </head>
  <!-- <body    class="bg-[#FAF9F5] text-black font-sans min-h-screen flex flex-col justify-between"  > -->
  <body
    class="font-sans antialiased selection:bg-lime selection:text-charcoal min-h-screen flex flex-col justify-between"
  >
    <!-- Header injected here -->
    <!-- [Include Header Template Code Here] -->
    <!-- Dynamically injects the reusable header layout component here -->
    <%- include('partials/header') %>

    <!-- TAB 6: CONTACT -->
    <!-- <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-1 w-full"> -->
    <main
      class="tab-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16"
    >
      <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Form -->
        <div
          class="bg-offwhite border-4 border-charcoal rounded-3xl p-8 shadow-genz space-y-6"
        >
          <div>
            <span
              class="bg-lavender text-charcoal font-display font-bold text-xs uppercase px-3 py-1 rounded-full border-2 border-charcoal shadow-genz-sm inline-block mb-2"
              >Get In Touch</span
            >
            <h2 class="font-display font-extrabold text-3xl">Drop Us a Line</h2>
            <p class="text-charcoal/70 text-sm mt-1">
              Have questions about collaborations, wholesale, or orders? Send a
              message.
            </p>
          </div>

          <form onsubmit="submitContactForm(event)" class="space-y-4">
            <div>
              <label class="block font-display font-bold text-sm mb-1"
                >Your Name</label
              >
              <input
                type="text"
                required
                placeholder="Sora Tanaka"
                class="w-full bg-white border-2 border-charcoal rounded-xl p-3 font-medium focus:outline-none focus:ring-2 focus:ring-lime"
              />
            </div>
            <div>
              <label class="block font-display font-bold text-sm mb-1"
                >Email Address</label
              >
              <input
                type="email"
                required
                placeholder="sora@example.com"
                class="w-full bg-white border-2 border-charcoal rounded-xl p-3 font-medium focus:outline-none focus:ring-2 focus:ring-lime"
              />
            </div>
            <div>
              <label class="block font-display font-bold text-sm mb-1"
                >Message</label
              >
              <textarea
                rows="4"
                required
                placeholder="Your message here..."
                class="w-full bg-white border-2 border-charcoal rounded-xl p-3 font-medium focus:outline-none focus:ring-2 focus:ring-lime"
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full bg-lime text-charcoal font-display font-bold py-3.5 rounded-xl border-2 border-charcoal shadow-genz hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all"
            >
              Send Message
            </button>
          </form>
        </div>

        <!-- Info & Newsletter -->
        <div class="space-y-8">
          <div
            class="bg-charcoal text-offwhite border-4 border-charcoal rounded-3xl p-8 shadow-genz space-y-6"
          >
            <h3 class="font-display font-bold text-2xl text-lime">
              Studio Info
            </h3>
            <div class="space-y-4 text-sm">
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-location-dot text-lime mt-1"></i>
                <div>
                  <p class="font-bold">Ink & Dye Studio</p>
                  <p class="text-offwhite/70">
                    742 Streetwear Ave, Arts District, LA
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-clock text-lime mt-1"></i>
                <div>
                  <p class="font-bold">Studio Hours</p>
                  <p class="text-offwhite/70">
                    Mon - Fri: 10:00 AM - 6:00 PM PST
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-envelope text-lime mt-1"></i>
                <div>
                  <p class="font-bold">Direct Email</p>
                  <p class="text-offwhite/70">support@inkandyetees.com</p>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-offwhite/20 flex gap-4">
              <a
                href="#"
                class="w-10 h-10 bg-offwhite text-charcoal rounded-xl border-2 border-charcoal flex items-center justify-center font-bold hover:bg-lime transition-colors"
                ><i class="fa-brands fa-instagram"></i
              ></a>
              <a
                href="#"
                class="w-10 h-10 bg-offwhite text-charcoal rounded-xl border-2 border-charcoal flex items-center justify-center font-bold hover:bg-lime transition-colors"
                ><i class="fa-brands fa-tiktok"></i
              ></a>
              <a
                href="#"
                class="w-10 h-10 bg-offwhite text-charcoal rounded-xl border-2 border-charcoal flex items-center justify-center font-bold hover:bg-lime transition-colors"
                ><i class="fa-brands fa-x-twitter"></i
              ></a>
              <a
                href="#"
                class="w-10 h-10 bg-offwhite text-charcoal rounded-xl border-2 border-charcoal flex items-center justify-center font-bold hover:bg-lime transition-colors"
                ><i class="fa-brands fa-discord"></i
              ></a>
            </div>
          </div>

          <!-- Newsletter Signup -->
          <div
            class="bg-lavender border-4 border-charcoal rounded-3xl p-8 shadow-genz space-y-4"
          >
            <h3 class="font-display font-bold text-2xl text-charcoal">
              Join the Drop List
            </h3>
            <p class="text-charcoal/80 text-sm">
              Get early access to limited edition hand-dyed drops and secret
              discount codes.
            </p>
            <form
              onsubmit="submitNewsletter(event)"
              class="flex flex-col sm:flex-row gap-3"
            >
              <input
                type="email"
                required
                placeholder="your.email@domain.com"
                class="flex-grow bg-white border-2 border-charcoal rounded-xl p-3 font-medium text-sm focus:outline-none focus:ring-2 focus:ring-lime"
              />
              <button
                type="submit"
                class="bg-lime text-charcoal font-display font-bold px-6 py-3 rounded-xl border-2 border-charcoal shadow-genz-sm hover:translate-x-0.5 hover:translate-y-0.5 transition-all text-sm"
              >
                Subscribe
              </button>
            </form>
          </div>
        </div>
      </div>
    </main>

    <!-- Slide-over Cart Drawer -->
    <div
      id="cart-drawer"
      class="fixed inset-y-0 right-0 z-50 w-full max-w-md bg-[#FAF9F5] border-l border-black/20 shadow-2xl transform translate-x-full transition-transform duration-300 flex flex-col"
    >
      <div
        class="p-6 border-b border-black/10 flex items-center justify-between"
      >
        <h3 class="font-black text-lg">Your Cart</h3>
        <button onclick="toggleCart()" class="p-2 font-bold hover:text-red-500">
          ✕
        </button>
      </div>
      <div
        id="cart-items-container"
        class="flex-1 overflow-y-auto p-6 space-y-4 custom-scrollbar"
      ></div>
      <div class="p-6 border-t border-black/10 bg-neutral-100">
        <div class="flex justify-between font-bold mb-4">
          <span>Subtotal</span>
          <span id="cart-total">$0.00</span>
        </div>
        <button
          onclick="alert('Checkout integration ready!')"
          class="w-full py-3.5 bg-black text-[#D4FF00] font-black rounded-xl hover:bg-neutral-800 transition"
        >
          Checkout Now
        </button>
      </div>
    </div>

    <!-- Footer -->
    <footer class="bg-charcoal text-offwhite border-t-4 border-charcoal mt-20">
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 md:grid-cols-4 gap-8"
      >
        <div class="space-y-4">
          <a
            href="/"
            class="text-1xl font-black tracking-tighter flex items-center gap-2"
          >
            <span
              class="w-4 h-4 rounded-full bg-[#D4FF00] border-2 border-black"
            ></span>
            INK & DYE <span class="text-neutral-500 font-light">TEES</span>
          </a>
          <p class="text-offwhite/70 text-xs">
            Handmade, hand-dyed custom streetwear crafted for Gen Z art, anime,
            and rebellious fashion fans.
          </p>
        </div>
        <div>
          <h4 class="font-display font-bold text-lime mb-3">
            Quick Navigation
          </h4>
          <ul class="space-y-2 text-xs font-semibold">
            <li>
              <a
                href="/"
                onclick="switchTab('home')"
                class="hover:text-lime transition-colors"
                >Home</a
              >
            </li>
            <li>
              <a
                href="/shop"
                onclick="switchTab('shop')"
                class="hover:text-lime transition-colors"
                >Shop Catalog</a
              >
            </li>
            <li>
              <a
                href="/custom"
                onclick="switchTab('custom')"
                class="hover:text-lime transition-colors"
                >Custom Tee Builder</a
              >
            </li>
            <li>
              <a
                href="/about"
                onclick="switchTab('about')"
                class="hover:text-lime transition-colors"
                >About Artist & Process</a
              >
            </li>
          </ul>
        </div>
        <div>
          <h4 class="font-display font-bold text-lime mb-3">Customer Care</h4>
          <ul class="space-y-2 text-xs font-semibold">
            <li>
              <a
                href="/faq"
                onclick="switchTab('faq')"
                class="hover:text-lime transition-colors"
                >Pricing & Turnaround</a
              >
            </li>
            <li>
              <a
                href="/faq"
                onclick="switchTab('faq')"
                class="hover:text-lime transition-colors"
                >Shipping & Returns</a
              >
            </li>
            <li>
              <a
                href="#faq"
                onclick="switchTab('faq')"
                class="hover:text-lime transition-colors"
                >Wash & Care Instructions</a
              >
            </li>
            <li>
              <a
                href="#faq"
                onclick="switchTab('faq')"
                class="hover:text-lime transition-colors"
                >Copyright & Licensing</a
              >
            </li>
          </ul>
        </div>
        <div>
          <h4 class="font-display font-bold text-lime mb-3">Connect With Us</h4>
          <div class="flex gap-3 mb-4">
            <a
              href="#"
              class="w-9 h-9 bg-offwhite/10 text-offwhite hover:bg-lime hover:text-charcoal rounded-xl border border-offwhite/20 flex items-center justify-center transition-colors"
              ><i class="fa-brands fa-instagram"></i
            ></a>
            <a
              href="#"
              class="w-9 h-9 bg-offwhite/10 text-offwhite hover:bg-lime hover:text-charcoal rounded-xl border border-offwhite/20 flex items-center justify-center transition-colors"
              ><i class="fa-brands fa-tiktok"></i
            ></a>
            <a
              href="#"
              class="w-9 h-9 bg-offwhite/10 text-offwhite hover:bg-lime hover:text-charcoal rounded-xl border border-offwhite/20 flex items-center justify-center transition-colors"
              ><i class="fa-brands fa-discord"></i
            ></a>
          </div>
          <p class="text-xs text-offwhite/50">
            &copy; 2026 Ink & Dye Tees. All rights reserved. Original artwork &
            custom designs protected.
          </p>
        </div>
      </div>
    </footer>

    <script src="/js/app.js"></script>
  </body>
</html>

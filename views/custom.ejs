<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Custom Order — Ink & Dye Tees</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body
    class="bg-[#FAF9F5] text-black font-sans min-h-screen flex flex-col justify-between"
  >
    <!-- Header injected here -->
    <!-- [Include Header Template Code Here] -->
    <!-- Dynamically injects the reusable header layout component here -->
    <%- include('partials/header') %>

    <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-1 w-full">
      <div class="mb-8 text-center">
        <h1 class="text-4xl font-black tracking-tight mb-2">
          Request a Custom Dye
        </h1>
        <p class="text-neutral-600">
          Submit your specifications, color palette preferences, and reference
          images.
        </p>
      </div>

      <form
        id="custom-form"
        onsubmit="submitCustomOrder(event)"
        class="bg-white border border-black/10 p-8 rounded-3xl shadow-sm space-y-6"
      >
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider mb-2"
            >Your Name</label
          >
          <input
            type="text"
            id="customer-name"
            required
            class="w-full px-4 py-3 rounded-xl border border-black/20 focus:outline-none focus:border-black text-sm"
          />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider mb-2"
            >Email Address</label
          >
          <input
            type="email"
            id="customer-email"
            required
            class="w-full px-4 py-3 rounded-xl border border-black/20 focus:outline-none focus:border-black text-sm"
          />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider mb-2"
            >Color Scheme / Style Notes</label
          >
          <textarea
            id="customer-notes"
            rows="4"
            required
            placeholder="Describe your vibe (e.g., Electric Lime and deep charcoal spiral pattern...)"
            class="w-full px-4 py-3 rounded-xl border border-black/20 focus:outline-none focus:border-black text-sm"
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full py-4 bg-black text-[#D4FF00] font-black rounded-xl hover:bg-neutral-800 transition"
        >
          Submit Custom Request
        </button>
      </form>
    </main>

    <!-- Slide-over Cart Drawer -->
    <div
      id="cart-drawer"
      class="fixed inset-y-0 right-0 z-50 w-full max-w-md bg-[#FAF9F5] border-l border-black/20 shadow-2xl transform translate-x-full transition-transform duration-300 flex flex-col"
    >
      <div
        class="p-6 border-b border-black/10 flex items-center justify-between"
      >
        <h3 class="font-black text-lg">Your Cart</h3>
        <button onclick="toggleCart()" class="p-2 font-bold hover:text-red-500">
          ✕
        </button>
      </div>
      <div
        id="cart-items-container"
        class="flex-1 overflow-y-auto p-6 space-y-4 custom-scrollbar"
      ></div>
      <div class="p-6 border-t border-black/10 bg-neutral-100">
        <div class="flex justify-between font-bold mb-4">
          <span>Subtotal</span>
          <span id="cart-total">$0.00</span>
        </div>
        <button
          onclick="alert('Checkout integration ready!')"
          class="w-full py-3.5 bg-black text-[#D4FF00] font-black rounded-xl hover:bg-neutral-800 transition"
        >
          Checkout Now
        </button>
      </div>
    </div>

    <script src="/js/app.js"></script>
    <script>
      async function submitCustomOrder(e) {
        e.preventDefault();
        const payload = {
          name: document.getElementById("customer-name").value,
          email: document.getElementById("customer-email").value,
          notes: document.getElementById("customer-notes").value,
          type: "custom",
        };
        const res = await fetch("/api/orders", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (data.success) {
          alert("Custom order submitted successfully!");
          document.getElementById("custom-form").reset();
        }
      }
    </script>
  </body>
</html>
